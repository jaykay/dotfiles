# ~/.config/odoo-mcp/env -- managed by chezmoi, secret from 1Password.
# Read by babelfish (odoo-mcp) whenever ODOO_URL / ODOO_API_KEY are not set in
# the environment. Mode 0600 via the private_ prefix on the source file.
#
# Fill in the op:// reference: op://<vault>/<item>/<field>, e.g. the
# "credential" field of an "API Credential" item. Check it with:
#   op read --no-newline "op://<vault>/<item>/<field>"
ODOO_URL=https://42nerds.odoo.com
ODOO_API_KEY={{ onepasswordRead "op://Employee/Odoo 42 N.E.R.D.S./Andere Felder/api_key" }}
# Optional, only for multi-database servers:
ODOO_DB=42nerds-odoo-production-737344
